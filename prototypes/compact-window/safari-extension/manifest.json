{
  "manifest_version": 3,
  "name": "Curious (Safari)",
  "version": "0.0.6",
  "description": "Select a word or phrase to learn more without losing your place.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Turn on Curious for this page",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://en.wikipedia.org/*"
  ],
  "icons": {
    "16": "icons/off-16.png",
    "32": "icons/off-32.png",
    "48": "icons/off-48.png",
    "128": "icons/off-128.png"
  }
}
